<div class="py-16 sm:py-24 px-4 sm:px-6">
  <div class="max-w-2xl mx-auto text-center">
    <h2 class="font-heading text-3xl sm:text-4xl font-extrabold text-brand-500 mb-4">
      <span class="block"><%= gettext("Translation unavailable")%></span>
    </h2>
    <p class="text-lg text-on-surface-secondary leading-relaxed mb-4"><%= gettext("We're sorry, the resource you're looking for has not been translated yet.")%></p>
    <p class="text-lg text-on-surface-secondary leading-relaxed"><%= gettext("If you speak that language, you can help translate")%> <%= link gettext("this page"), to: "https://github.com/elixirschool/elixirschool/tree/master/lessons/#{@missing_locale}", target: "_blank", rel: "noopener noreferrer", class: "font-semibold text-brand-500 hover:text-brand-600 transition-colors" %>.</p>
  </div>
</div>
