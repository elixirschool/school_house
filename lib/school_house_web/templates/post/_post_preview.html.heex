<div class="group bg-surface-card border border-border-subtle rounded-design-lg overflow-hidden transition-all duration-300 hover:border-brand-300 hover:shadow-design-lg hover:-translate-y-1">
  <div class="h-1 bg-gradient-to-r from-brand-400 to-brand-600"></div>
  <div class="p-6">
    <div class="flex flex-wrap gap-1.5 mb-3">
      <%= for tag <- @post.tags do %>
        <%= link(to: Routes.post_path(@conn, :filter_by_tag, String.downcase(tag))) do %>
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full font-mono text-[0.68rem] font-medium bg-brand-50 text-brand-600">
            <%= String.downcase(tag) %>
          </span>
        <% end %>
      <% end %>
    </div>
    <%= link(to: Routes.post_path(@conn, :show, @post.slug), class: "block") do %>
      <h3 class="font-heading text-lg font-bold text-on-surface leading-snug mb-2 group-hover:text-brand-500 transition-colors"><%= raw @post.title %></h3>
      <p class="text-sm text-on-surface-secondary leading-relaxed mb-4"><%= raw @post.excerpt %></p>
    <% end %>
    <div class="flex items-center gap-2.5 text-sm text-on-surface-muted">
      <div class="flex-shrink-0">
        <img class="w-7 h-7 rounded-full" src={avatar_url(@post.author_link)} alt={@post.author}>
      </div>
      <span class="font-medium"><%= @post.author %></span>
      <span>·</span>
      <time><%= @post.date %></time>
    </div>
  </div>
</div>
