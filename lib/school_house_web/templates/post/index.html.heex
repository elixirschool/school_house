<div class="py-16 sm:py-24 px-4 sm:px-6">
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-14">
      <div class="font-mono text-xs font-semibold uppercase tracking-[0.12em] text-brand-500 mb-3"><%= gettext("From the Blog") %></div>
      <h2 class="font-heading text-4xl font-extrabold tracking-tight text-on-surface mb-4">
        <%= assigns[:blog_heading] || gettext("Recent Posts") %>
      </h2>
      <p class="text-lg text-on-surface-secondary max-w-xl mx-auto">
        <%= gettext("Articles authored by Elixir School contributors and members of the community.") %>
      </p>
    </div>

    <div class="grid gap-6 lg:grid-cols-3 md:grid-cols-2">
      <%= for post <- @posts do %>
        <%= render("_post_preview.html", conn: @conn, post: post) %>
      <% end %>
    </div>

    <%= if @conn.assigns.page_title == "Blog" do %>
      <div class="flex justify-center mt-12">
        <div class="inline-flex gap-2">
          <%= for page <- 1..@pages do %>
            <%= link(to: Routes.post_path(@conn, :index, page: (page - 1)), class: "inline-flex items-center justify-center w-10 h-10 border border-border-subtle rounded-design-sm text-sm font-medium text-on-surface-secondary hover:border-brand-400 hover:text-brand-500 transition-all") do %>
              <%= page %>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
