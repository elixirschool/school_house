<section class="max-w-3xl mx-auto px-4 sm:px-6 py-12 sm:py-16">
  <div class="text-center mb-8">
    <div class="font-mono text-xs font-semibold uppercase tracking-[0.12em] text-brand-500 mb-4"><%= gettext("Elixir School Presents") %></div>
    <h1 class="font-heading text-3xl sm:text-4xl font-extrabold tracking-tight text-on-surface mb-4"><%= @post.title |> strip_p_tags() |> raw() %></h1>
    <p class="text-sm text-on-surface-muted">
      <%= gettext("By") %> <%= @post.author %> · <%= gettext("Posted") %> <%= @post.date %>
    </p>
  </div>

  <%= if @post.excerpt do %>
    <div class="bg-surface-secondary border border-border-subtle rounded-design-md p-5 mb-8 text-center text-on-surface-secondary">
      <%= raw @post.excerpt %>
    </div>
  <% end %>

  <div class="prose dark:prose-dark max-w-none">
    <%= raw @post.body %>
  </div>
</section>
