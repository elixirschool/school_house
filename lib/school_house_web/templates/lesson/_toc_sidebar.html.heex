<div class="toc-title"><%= gettext("On This Page") %></div>
<div class="toc-links">
  <%= raw @lesson.table_of_contents %>
</div>

<div class="toc-actions">
  <a href={"https://github.com/elixirschool/elixirschool/edit/main/lessons/#{@lesson.locale}/#{@lesson.section}/#{@lesson.name}.md"} target="_blank" rel="noopener noreferrer" class="toc-action-btn">
    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" /></svg>
    <%= gettext("Edit on GitHub") %>
    <span class="sr-only">(opens in new tab)</span>
  </a>
  <a href={"https://github.com/elixirschool/elixirschool/issues/new?title=#{URI.encode("Issue with #{@lesson.section}/#{@lesson.name}")}"} target="_blank" rel="noopener noreferrer" class="toc-action-btn">
    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4.5c-.77-.833-2.694-.833-3.464 0L3.34 16.5c-.77.833.192 2.5 1.732 2.5z" /></svg>
    <%= gettext("Report an Issue") %>
    <span class="sr-only">(opens in new tab)</span>
  </a>
</div>
