<div class="max-w-4xl mx-auto px-4 sm:px-6 py-8">
  <div class="flex flex-col md:flex-row md:justify-between gap-4 pt-8 border-t border-border-subtle">
    <div class="md:w-1/2">
      <%= if @previous do %>
        <%= lesson_link(@conn, @previous.section, @previous.name, "group flex flex-col gap-1 p-4 border border-border-subtle rounded-design-md hover:border-brand-300 hover:shadow-design-sm transition-all") do %>
          <span class="text-xs font-medium uppercase tracking-wider text-on-surface-muted"><%= gettext("Previous Lesson") %></span>
          <span class="font-heading text-sm font-semibold text-brand-500 group-hover:text-brand-600 transition-colors">← <%= @previous.title %></span>
        <% end %>
      <% end %>
    </div>
    <div class="md:w-1/2">
      <%= if @next do %>
        <%= lesson_link(@conn, @next.section, @next.name, "group flex flex-col gap-1 p-4 border border-border-subtle rounded-design-md hover:border-brand-300 hover:shadow-design-sm transition-all text-right ml-auto") do %>
          <span class="text-xs font-medium uppercase tracking-wider text-on-surface-muted"><%= gettext("Next Lesson") %></span>
          <span class="font-heading text-sm font-semibold text-brand-500 group-hover:text-brand-600 transition-colors"><%= @next.title %> →</span>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
