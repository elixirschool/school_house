<%= content_tag String.to_atom(@header), class: "flex items-center group font-heading font-bold text-on-surface scroll-mt-20", id: @fragment do %>
  <a href={"##{@fragment}"} class="hover:text-brand-500 transition-colors"><%= @name %></a>
  <a href="#" title="go to top of page" class="ml-2 text-on-surface-muted opacity-0 group-hover:opacity-100 transition-opacity">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7" />
    </svg>
  </a>
<% end %>
