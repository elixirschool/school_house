<div class="bg-surface py-12 px-4 sm:px-6 lg:py-16 lg:px-8">
  <div class="max-w-7xl mx-auto">
    <div class="px-6 py-10 bg-brand-600 rounded-design-lg sm:py-16 sm:px-12 lg:p-20 lg:flex lg:items-center">
      <div class="lg:w-0 lg:flex-1">
        <h2 class="font-heading text-3xl font-extrabold tracking-tight text-white">
          <%= gettext("Sign up for our newsletter") %>
        </h2>
        <p class="max-w-3xl mt-4 text-lg text-white/90">
          <%= gettext("Join the Elixir School newsletter to keep up with the latest lessons, blog posts, and opportunities within the community.") %>
        </p>
      </div>
      <div class="mt-12 sm:w-full sm:max-w-md lg:mt-0 lg:ml-8 lg:flex-1">
        <form class="sm:flex">
          <label for="emailAddress" class="sr-only"><%= gettext("Email address") %></label>
          <input id="emailAddress" name="emailAddress" type="email" autocomplete="email" required aria-describedby="email-error" class="w-full px-5 py-3 text-on-surface placeholder-on-surface-muted border-white focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-brand-700 focus:ring-white rounded-design-md" placeholder={gettext("Enter your email")}>
          <p id="email-error" class="hidden mt-1 text-sm text-white font-medium" role="alert"></p>
          <button type="submit" class="flex items-center justify-center w-full px-5 py-3 mt-3 text-base font-medium text-white border border-transparent rounded-design-md bg-brand-500 hover:bg-brand-400 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-brand-700 focus:ring-white sm:mt-0 sm:ml-3 sm:w-auto sm:flex-shrink-0 transition-colors">
            <%= gettext("Notify me") %>
          </button>
        </form>
        <p class="mt-3 text-sm text-white/80">
          <%= gettext("We care about the protection of your data. Read our") %>
          <a href={Routes.page_path(@conn, :privacy)} class="font-medium text-white underline">
            <%= gettext("Privacy Policy") %>.
          </a>
        </p>
      </div>
    </div>
  </div>
</div>
