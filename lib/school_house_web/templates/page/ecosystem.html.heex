<div class="py-16 sm:py-24 px-4 sm:px-6">
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-14">
      <div class="font-mono text-xs font-semibold uppercase tracking-[0.12em] text-brand-500 mb-3"><%= gettext("Discover") %></div>
      <h1 class="font-heading text-4xl sm:text-5xl font-extrabold tracking-tight text-on-surface mb-4"><%= gettext("The Elixir Ecosystem") %></h1>
      <p class="text-lg text-on-surface-secondary max-w-2xl mx-auto">
        <%= gettext("Elixir's ecosystem includes world-class frameworks and tools that make developers productive across domains — from web development and machine learning to embedded systems and data processing.") %>
      </p>
    </div>

    <div class="bg-surface-card border border-border-subtle rounded-design-lg p-8 sm:p-10">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Phoenix & LiveView -->
        <div class="bg-surface-secondary rounded-design-md p-6">
          <div class="w-10 h-10 rounded-lg bg-brand-100 flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-brand-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.986-7C14 5 16.09 5.777 17.656 7.343A7.975 7.975 0 0120 13a7.975 7.975 0 01-2.343 5.657z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.879 16.121A3 3 0 1012.015 11L11 14H9c0 .768.293 1.536.879 2.121z" />
            </svg>
          </div>
          <h3 class="font-heading text-lg font-bold text-on-surface mb-2"><%= gettext("Phoenix & LiveView") %></h3>
          <p class="text-sm text-on-surface-secondary leading-relaxed mb-3">
            <%= gettext("The premier web framework for Elixir with built-in real-time UI capabilities. Build rich, interactive applications with server-rendered HTML — no JavaScript framework required.") %>
          </p>
          <a target="_blank" rel="noopener noreferrer" href="https://www.phoenixframework.org/" class="inline-flex items-center text-sm font-semibold text-brand-500 hover:text-brand-600 transition-colors">
            phoenixframework.org
            <svg class="w-3.5 h-3.5 ml-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
            <span class="sr-only">(opens in new tab)</span>
          </a>
        </div>

        <!-- Livebook -->
        <div class="bg-surface-secondary rounded-design-md p-6">
          <div class="w-10 h-10 rounded-lg bg-brand-100 flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-brand-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
            </svg>
          </div>
          <h3 class="font-heading text-lg font-bold text-on-surface mb-2"><%= gettext("Livebook") %></h3>
          <p class="text-sm text-on-surface-secondary leading-relaxed mb-3">
            <%= gettext("Interactive notebooks for Elixir. Explore data, prototype ideas, and collaborate with rich documentation — all in a beautiful web-based interface.") %>
          </p>
          <a target="_blank" rel="noopener noreferrer" href="https://livebook.dev/" class="inline-flex items-center text-sm font-semibold text-brand-500 hover:text-brand-600 transition-colors">
            livebook.dev
            <svg class="w-3.5 h-3.5 ml-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
            <span class="sr-only">(opens in new tab)</span>
          </a>
        </div>

        <!-- Nx & Bumblebee -->
        <div class="bg-surface-secondary rounded-design-md p-6">
          <div class="w-10 h-10 rounded-lg bg-brand-100 flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-brand-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <h3 class="font-heading text-lg font-bold text-on-surface mb-2"><%= gettext("Nx & Bumblebee") %></h3>
          <p class="text-sm text-on-surface-secondary leading-relaxed mb-3">
            <%= gettext("Numerical computing and machine learning for Elixir. Run pre-trained models from Hugging Face, build neural networks, and leverage GPU acceleration natively.") %>
          </p>
          <a target="_blank" rel="noopener noreferrer" href="https://github.com/elixir-nx" class="inline-flex items-center text-sm font-semibold text-brand-500 hover:text-brand-600 transition-colors">
            github.com/elixir-nx
            <svg class="w-3.5 h-3.5 ml-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
            <span class="sr-only">(opens in new tab)</span>
          </a>
        </div>

        <!-- Nerves -->
        <div class="bg-surface-secondary rounded-design-md p-6">
          <div class="w-10 h-10 rounded-lg bg-brand-100 flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-brand-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z" />
            </svg>
          </div>
          <h3 class="font-heading text-lg font-bold text-on-surface mb-2"><%= gettext("Nerves") %></h3>
          <p class="text-sm text-on-surface-secondary leading-relaxed mb-3">
            <%= gettext("Build and deploy embedded software in Elixir. Craft firmware for Raspberry Pi and other IoT devices with the fault tolerance and reliability of the BEAM.") %>
          </p>
          <a target="_blank" rel="noopener noreferrer" href="https://nerves-project.org/" class="inline-flex items-center text-sm font-semibold text-brand-500 hover:text-brand-600 transition-colors">
            nerves-project.org
            <svg class="w-3.5 h-3.5 ml-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
            <span class="sr-only">(opens in new tab)</span>
          </a>
        </div>

        <!-- Ecto -->
        <div class="bg-surface-secondary rounded-design-md p-6">
          <div class="w-10 h-10 rounded-lg bg-brand-100 flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-brand-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4" />
            </svg>
          </div>
          <h3 class="font-heading text-lg font-bold text-on-surface mb-2"><%= gettext("Ecto") %></h3>
          <p class="text-sm text-on-surface-secondary leading-relaxed mb-3">
            <%= gettext("A toolkit for data mapping and query building. Ecto provides changesets for data validation, composable queries, and database migrations for Elixir applications.") %>
          </p>
          <a target="_blank" rel="noopener noreferrer" href="https://hexdocs.pm/ecto" class="inline-flex items-center text-sm font-semibold text-brand-500 hover:text-brand-600 transition-colors">
            hexdocs.pm/ecto
            <svg class="w-3.5 h-3.5 ml-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
            <span class="sr-only">(opens in new tab)</span>
          </a>
        </div>

        <!-- Oban -->
        <div class="bg-surface-secondary rounded-design-md p-6">
          <div class="w-10 h-10 rounded-lg bg-brand-100 flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-brand-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
            </svg>
          </div>
          <h3 class="font-heading text-lg font-bold text-on-surface mb-2"><%= gettext("Oban") %></h3>
          <p class="text-sm text-on-surface-secondary leading-relaxed mb-3">
            <%= gettext("Robust, database-backed job processing for Elixir. Schedule, queue, and execute background work with reliability, observability, and built-in resilience.") %>
          </p>
          <a target="_blank" rel="noopener noreferrer" href="https://oban.pro/" class="inline-flex items-center text-sm font-semibold text-brand-500 hover:text-brand-600 transition-colors">
            oban.pro
            <svg class="w-3.5 h-3.5 ml-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
            <span class="sr-only">(opens in new tab)</span>
          </a>
        </div>

        <!-- Broadway -->
        <div class="bg-surface-secondary rounded-design-md p-6">
          <div class="w-10 h-10 rounded-lg bg-brand-100 flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-brand-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 17h8m0 0V9m0 8l-8-8-4 4-6-6" />
            </svg>
          </div>
          <h3 class="font-heading text-lg font-bold text-on-surface mb-2"><%= gettext("Broadway") %></h3>
          <p class="text-sm text-on-surface-secondary leading-relaxed mb-3">
            <%= gettext("Concurrent, multi-stage data ingestion and processing. Build data pipelines with back-pressure, batching, and fault tolerance powered by GenStage.") %>
          </p>
          <a target="_blank" rel="noopener noreferrer" href="https://elixir-broadway.org/" class="inline-flex items-center text-sm font-semibold text-brand-500 hover:text-brand-600 transition-colors">
            elixir-broadway.org
            <svg class="w-3.5 h-3.5 ml-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
            <span class="sr-only">(opens in new tab)</span>
          </a>
        </div>

        <!-- Ash Framework -->
        <div class="bg-surface-secondary rounded-design-md p-6">
          <div class="w-10 h-10 rounded-lg bg-brand-100 flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-brand-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
            </svg>
          </div>
          <h3 class="font-heading text-lg font-bold text-on-surface mb-2"><%= gettext("Ash Framework") %></h3>
          <p class="text-sm text-on-surface-secondary leading-relaxed mb-3">
            <%= gettext("A declarative, resource-oriented application framework. Model your domain, and Ash generates APIs, admin interfaces, and more from your resource definitions.") %>
          </p>
          <a target="_blank" rel="noopener noreferrer" href="https://ash-hq.org/" class="inline-flex items-center text-sm font-semibold text-brand-500 hover:text-brand-600 transition-colors">
            ash-hq.org
            <svg class="w-3.5 h-3.5 ml-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
            <span class="sr-only">(opens in new tab)</span>
          </a>
        </div>

        <!-- Hologram -->
        <div class="bg-surface-secondary rounded-design-md p-6">
          <div class="w-10 h-10 rounded-lg bg-brand-100 flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-brand-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 10l-2 1m0 0l-2-1m2 1v2.5M20 7l-2 1m2-1l-2-1m2 1v2.5M14 4l-2-1-2 1M4 7l2-1M4 7l2 1M4 7v2.5M12 21l-2-1m2 1l2-1m-2 1v-2.5M6 18l-2-1v-2.5M18 18l2-1v-2.5" />
            </svg>
          </div>
          <h3 class="font-heading text-lg font-bold text-on-surface mb-2"><%= gettext("Hologram") %></h3>
          <p class="text-sm text-on-surface-secondary leading-relaxed mb-3">
            <%= gettext("A full-stack, reactive web framework for Elixir. Write both front-end and back-end code in Elixir with seamless client-server interactivity.") %>
          </p>
          <a target="_blank" rel="noopener noreferrer" href="https://hologram.page/" class="inline-flex items-center text-sm font-semibold text-brand-500 hover:text-brand-600 transition-colors">
            hologram.page
            <svg class="w-3.5 h-3.5 ml-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
            <span class="sr-only">(opens in new tab)</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</div>
