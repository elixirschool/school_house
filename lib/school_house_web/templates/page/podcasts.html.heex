<div class="py-16 sm:py-24 px-4 sm:px-6">
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-14">
      <div class="font-mono text-xs font-semibold uppercase tracking-[0.12em] text-brand-500 mb-3"><%= gettext("Listen & Learn") %></div>
      <h1 class="font-heading text-4xl sm:text-5xl font-extrabold tracking-tight text-on-surface mb-4"><%= gettext("Elixir Podcasts") %></h1>
      <p class="text-lg text-on-surface-secondary max-w-xl mx-auto">
        <%= gettext("Check out all the great of Podcasts that focus on Elixir and the BEAM ecosystem!") %>
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      <%= for podcast <- @podcasts do %>
        <div class="group bg-surface-card border border-border-subtle rounded-design-lg overflow-hidden transition-all duration-300 hover:border-brand-300 hover:shadow-design-lg hover:-translate-y-1">
          <a href={podcast.website} target="_blank" rel="noopener noreferrer" class="block" tabindex="-1" aria-hidden="true">
            <div class="aspect-w-3 aspect-h-2 bg-surface-secondary">
              <img class="object-scale-down" src={Routes.static_path(@conn, "/images/#{podcast.logo}")} alt={"#{podcast.name} logo"}>
            </div>
            <span class="sr-only">(opens in new tab)</span>
          </a>
          <div class="p-6">
            <%= link(to: podcast.website, target: "_blank", rel: "noopener noreferrer") do %>
              <h3 class="font-heading text-xl font-bold text-on-surface group-hover:text-brand-500 transition-colors mb-1"><%= podcast.name %></h3>
              <%= if podcast.language do %>
                <p class="text-sm text-on-surface-muted mb-3"><%= podcast.language %></p>
              <% end %>
            <% end %>
            <p class="text-on-surface-secondary leading-relaxed"><%= podcast.about %></p>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
