<tr class="bg-red-50 dark:bg-red-900/10">
  <td class="px-6 py-4 text-sm font-medium text-on-surface whitespace-nowrap">
    <%= @line.original.title %>
  </td>
  <td class="px-6 py-4 text-sm text-on-surface-muted whitespace-nowrap">
  </td>
  <td class="px-6 py-4 text-sm text-on-surface-secondary whitespace-nowrap">
    <%= friendly_version(@line.original.version) %>
  </td>
  <td class="px-6 py-4 text-sm text-on-surface-muted whitespace-nowrap">
  </td>
</tr>
