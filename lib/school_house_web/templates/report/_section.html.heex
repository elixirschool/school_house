<div class="mb-8">
  <h3 class="font-heading text-lg font-semibold text-on-surface mb-4">
    <%= @section %>
  </h3>
  <div class="bg-surface-card border border-border-subtle rounded-xl overflow-hidden shadow-design-sm">
    <table class="min-w-full divide-y divide-border-subtle">
      <thead class="bg-surface-secondary">
        <tr>
          <th scope="col" class="px-6 py-3 text-xs font-semibold uppercase tracking-widest text-on-surface-muted text-left">
            <%= gettext("Lesson") %>
          </th>
          <th scope="col" class="px-6 py-3 text-xs font-semibold uppercase tracking-widest text-on-surface-muted text-left">
            <%= gettext("Translated Title") %>
          </th>
          <th scope="col" class="px-6 py-3 text-xs font-semibold uppercase tracking-widest text-on-surface-muted text-left">
            <%= gettext("Original Version") %>
          </th>
          <th scope="col" class="px-6 py-3 text-xs font-semibold uppercase tracking-widest text-on-surface-muted text-left">
            <%= gettext("Translated Version") %>
          </th>
        </tr>
      </thead>
      <tbody class="divide-y divide-border-subtle">
        <%= for line <- @lessons do %>
          <%= cond do %>
            <% is_nil(line.original) -> %>
              <%= render("_coming_soon.html", line: line) %>
            <% is_nil(line.lesson) -> %>
              <%= render("_missing.html", line: line) %>
            <% true -> %>
              <%= render("_lesson.html", line: line) %>
          <% end %>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
