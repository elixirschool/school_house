<div id="locale-menu-container" class="relative inline-block text-left" x-data="{ isOpen: false }" @keydown.escape="isOpen = false">
  <button @click="isOpen = !isOpen" type="button" class="inline-flex items-center gap-1.5 px-3 py-1.5 border border-border-subtle rounded-full bg-surface-card text-on-surface-secondary text-sm font-medium hover:border-brand-400 transition-all" id="locale-menu" x-bind:aria-expanded="isOpen" aria-haspopup="true" aria-controls="locale-menu-dropdown" title={current_locale_info().original_name}>
    <span class={ "fi fi-#{current_locale_info().flag_icon} text-base" } />
    <span class="text-xs font-semibold uppercase"><%= current_locale_info().code %></span>
    <svg class="w-3.5 h-3.5 opacity-50" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
      <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
    </svg>
  </button>
  <div id="locale-menu-dropdown" x-cloak x-show="isOpen" @click.away="isOpen = false" class="origin-top-right absolute right-0 mt-2 w-28 max-h-80 overflow-y-auto rounded-xl shadow-design-lg bg-surface-card border border-border-subtle focus:outline-none" role="menu" aria-orientation="vertical" aria-labelledby="locale-menu">
    <div class="py-1" role="none">
      <%= for locale <- supported_locales() do %>
        <a href={current_page_locale_path(@conn, locale.code)} role="menuitem" class="flex items-center gap-2 px-3 py-2 text-sm text-on-surface-secondary hover:bg-surface-secondary hover:text-brand-500 transition-colors" title={locale.original_name}>
          <span class={ "fi fi-#{locale.flag_icon} text-base" } />
          <span class="text-xs font-medium"><%= locale.code %></span>
        </a>
      <% end %>
    </div>
  </div>
</div>
