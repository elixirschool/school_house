<nav class="fixed top-0 left-0 right-0 z-50 px-4 sm:px-8 border-b border-border-subtle bg-surface-nav backdrop-blur-xl" style="backdrop-filter: blur(20px) saturate(1.8);">
  <div class="max-w-7xl mx-auto flex items-center justify-between h-16">
    <!-- Logo -->
    <%= link(to: Routes.page_path(@conn, :index, current_locale()), class: "flex items-center gap-2.5 no-underline text-on-surface") do %>
      <img src="/brand/elixir-school-icon.png" alt="" class="w-8 h-8 rounded-lg" />
      <span class="font-heading font-bold text-lg tracking-tight">elixir <span class="text-brand-500">school</span></span>
    <% end %>

    <!-- Desktop Nav Links -->
    <ul class="hidden md:flex items-center gap-8 list-none">
      <li>
        <%= link(gettext("Why Elixir?"), to: Routes.page_path(@conn, :why, current_locale()), class: "text-on-surface-secondary text-sm font-medium no-underline hover:text-brand-500 relative after:content-[''] after:absolute after:bottom-[-4px] after:left-0 after:w-0 after:h-0.5 after:bg-brand-500 after:rounded-sm after:transition-all hover:after:w-full") %>
      </li>
      <li>
        <%= link(gettext("Ecosystem"), to: Routes.page_path(@conn, :ecosystem, current_locale()), class: "text-on-surface-secondary text-sm font-medium no-underline hover:text-brand-500 relative after:content-[''] after:absolute after:bottom-[-4px] after:left-0 after:w-0 after:h-0.5 after:bg-brand-500 after:rounded-sm after:transition-all hover:after:w-full") %>
      </li>
      <li>
        <%= render("_lesson_menu.html", conn: @conn) %>
      </li>
      <li>
        <%= link(gettext("Blog"), to: Routes.post_path(@conn, :index), class: "text-on-surface-secondary text-sm font-medium no-underline hover:text-brand-500 relative after:content-[''] after:absolute after:bottom-[-4px] after:left-0 after:w-0 after:h-0.5 after:bg-brand-500 after:rounded-sm after:transition-all hover:after:w-full") %>
      </li>
      <li>
        <%= link(gettext("Get Involved"), to: Routes.page_path(@conn, :get_involved, current_locale()), class: "text-on-surface-secondary text-sm font-medium no-underline hover:text-brand-500 relative after:content-[''] after:absolute after:bottom-[-4px] after:left-0 after:w-0 after:h-0.5 after:bg-brand-500 after:rounded-sm after:transition-all hover:after:w-full") %>
      </li>
    </ul>

    <!-- Right Side: Locale, Theme, GitHub -->
    <div class="hidden md:flex items-center gap-3">
      <%= render("_locale_menu.html", conn: @conn) %>
      <%= render("_dark_mode_toggle.html", conn: @conn) %>
      <a href="https://github.com/elixirschool" target="_blank" rel="noopener noreferrer" class="flex items-center gap-1.5 px-3.5 py-1.5 border border-border-subtle rounded-full bg-surface-card text-on-surface-secondary text-sm font-medium no-underline hover:border-brand-400 hover:text-brand-600 transition-all">
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
        GitHub
        <span class="sr-only">(opens in new tab)</span>
      </a>
    </div>

    <!-- Mobile Hamburger -->
    <button id="menu-toggle-button" class="md:hidden w-10 h-10 flex items-center justify-center text-on-surface rounded-lg hover:bg-surface-secondary" aria-label="Toggle menu" aria-expanded="false" aria-controls="mobile-menu">
      <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M3 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 10a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 15a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z" clip-rule="evenodd"></path></svg>
    </button>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-border-subtle bg-surface pb-4">
    <ul class="flex flex-col py-2">
      <li>
        <%= link(gettext("Why Elixir?"), to: Routes.page_path(@conn, :why, current_locale()), class: "block py-3 px-4 text-on-surface-secondary font-medium hover:text-brand-500 hover:bg-surface-secondary") %>
      </li>
      <li>
        <%= link(gettext("Ecosystem"), to: Routes.page_path(@conn, :ecosystem, current_locale()), class: "block py-3 px-4 text-on-surface-secondary font-medium hover:text-brand-500 hover:bg-surface-secondary") %>
      </li>
      <li>
        <%= link(gettext("Lessons"), to: Routes.lesson_path(@conn, :index, current_locale(), :basics), class: "block py-3 px-4 text-on-surface-secondary font-medium hover:text-brand-500 hover:bg-surface-secondary") %>
      </li>
      <li>
        <%= link(gettext("Blog"), to: Routes.post_path(@conn, :index), class: "block py-3 px-4 text-on-surface-secondary font-medium hover:text-brand-500 hover:bg-surface-secondary") %>
      </li>
      <li>
        <%= link(gettext("Get Involved"), to: Routes.page_path(@conn, :get_involved, current_locale()), class: "block py-3 px-4 text-on-surface-secondary font-medium hover:text-brand-500 hover:bg-surface-secondary") %>
      </li>
    </ul>
    <div class="flex items-center gap-3 px-4 pt-2 border-t border-border-subtle">
      <%= render("_locale_menu.html", conn: @conn) %>
      <%= render("_dark_mode_toggle.html", conn: @conn) %>
    </div>
  </div>
</nav>
